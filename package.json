{
	"name": "@edlsh/omp-computer-use",
	"version": "0.1.0",
	"description": "Native OMP extension for observing and controlling macOS and Windows apps.",
	"type": "module",
	"keywords": [
		"omp",
		"oh-my-pi",
		"omp-extension",
		"computer-use",
		"macos",
		"windows",
		"desktop-automation",
		"accessibility"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/edlsh/omp-computer-use.git"
	},
	"bugs": {
		"url": "https://github.com/edlsh/omp-computer-use/issues"
	},
	"homepage": "https://github.com/edlsh/omp-computer-use#readme",
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"extensions",
		"skills",
		"src",
		"scripts/build-native.mjs",
		"scripts/setup-helper.mjs",
		"native/macos/bridge.swift",
		"native/windows/bridge-rs/Cargo.lock",
		"native/windows/bridge-rs/Cargo.toml",
		"native/windows/bridge-rs/src",
		"native/windows/bridge-rs/tests",
		"prebuilt/macos",
		"prebuilt/windows",
		"assets/reference/img.jpg",
		"README.md",
		"LICENSE"
	],
	"omp": {
		"extensions": [
			"./extensions"
		],
		"skills": [
			"./skills"
		],
		"image": "./assets/reference/img.jpg"
	},
	"scripts": {
		"postinstall": "bun scripts/setup-helper.mjs --postinstall",
		"typecheck": "tsc -p tsconfig.json",
		"test:schema": "bun scripts/check-tool-schemas.mjs",
		"test:omp": "bun scripts/check-omp-extension.mjs",
		"test:invariants": "bun scripts/check-invariants.mjs",
		"test:lifecycle": "bun scripts/check-session-lifecycle.mjs",
		"test:runtime": "bun scripts/check-runtime-concurrency.mjs",
		"test:commits": "bun scripts/check-commit-messages.mjs",
		"test:platform": "bun scripts/check-platform-windows.mjs",
		"test:windows-scripts": "bun scripts/check-windows-build-scripts.mjs",
		"test:signing": "bun scripts/check-local-signing.mjs",
		"test:mcp-parity": "bun packages/mcp/scripts/check-schema-parity.mjs",
		"test:mcp-smoke": "bun packages/mcp/scripts/smoke.mjs",
		"test:mcp-smoke:live": "CUA_SMOKE_LIVE=1 bun packages/mcp/scripts/smoke.mjs",
		"mcp": "bun packages/mcp/src/main.ts",
		"test": "bun run typecheck && bun run test:schema && bun run test:omp && bun run test:lifecycle && bun run test:runtime && bun run test:invariants && bun run test:signing && bun run test:mcp-parity",
		"build:native": "bun scripts/build-native.mjs",
		"build:windows": "bun scripts/build-native.mjs --platform windows"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": ">=16.4.6"
	},
	"devDependencies": {
		"@oh-my-pi/pi-coding-agent": "16.4.8",
		"@types/bun": "^1.3.14",
		"typescript": "^6.0.3"
	}
}
